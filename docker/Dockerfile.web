FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/

RUN npm ci --workspace=@gamefication/web --include-workspace-root

COPY apps/web/tsconfig.json apps/web/tsconfig.node.json apps/web/
COPY apps/web/index.html apps/web/vite.config.ts apps/web/
COPY apps/web/postcss.config.js apps/web/tailwind.config.js apps/web/
COPY apps/web/assets apps/web/assets
COPY apps/web/public apps/web/public
COPY apps/web/src apps/web/src

EXPOSE 5173

CMD ["npm", "run", "dev", "-w", "@gamefication/web"]
